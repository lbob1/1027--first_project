# MiniKnora 环境变量样例（M-S0-T03 创建）。
# 使用方式：复制本文件为 .env 后填入真实值；.env 已被 .gitignore 忽略，严禁提交。
# 本文件只含占位符，不含任何真实凭据（硬性约束）。
# 注释一律独立成行（部分 .env 解析器不支持行内注释）。

# ---------- 模型（compatible-mode） ----------
# OPENAI_API_BASE：模型服务 base url
OPENAI_API_BASE=
# OPENAI_API_KEY：模型调用密钥（细则 9：只存 .env，不入代码与日志）
OPENAI_API_KEY=
# CHAT_MODEL：对话模型型号
CHAT_MODEL=
# EMBEDDING_MODEL：向量模型型号
EMBEDDING_MODEL=
# EMBEDDING_DIM：向量维度，必须与所选 embedding 模型输出一致（P-S1 要求）
EMBEDDING_DIM=1024

# ---------- 数据库 / 缓存 / 对象存储 ----------
# DATABASE_URL：SQLAlchemy 用连接串（S1 起使用，驱动为 psycopg）
DATABASE_URL=postgresql+psycopg://用户名:密码@localhost:5432/库名
# REDIS_URL：Celery broker（S2 起使用）
REDIS_URL=redis://localhost:6379/0
# MINIO_ENDPOINT：MinIO 服务地址（与 compose.yaml 暴露端口一致）
MINIO_ENDPOINT=localhost:9000
# 说明：MINIO_ACCESS_KEY / MINIO_SECRET_KEY 是应用侧 SDK 的命名习惯，
# 其值与 compose.yaml 使用的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 完全相同（同一对凭据，两种叫法）。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MINIO_BUCKET：对象存储桶名（S2-T01 启动时自动创建）
MINIO_BUCKET=miniknora

# ---------- Rerank（S3-T04 起使用，DashScope 原生端点） ----------
# RERANK_MODEL：重排模型型号（默认 gte-rerank-v2；老 gte-rerank 部分账号未开通会 403）
RERANK_MODEL=gte-rerank-v2
# RERANK_ENABLED：重排开关（false 整体跳过，降级为 rrf_score 原序）
RERANK_ENABLED=true

# ---------- 认证（S5 起使用） ----------
# JWT_SECRET_KEY：HS256 签名密钥（细则 9：只存 .env；为空则认证调用 fail-fast；
# 长度建议 ≥32 字节，pyjwt 对短密钥会告警 InsecureKeyLengthWarning）
JWT_SECRET_KEY=
# JWT_EXPIRE：token 有效期（秒，默认 1800）
JWT_EXPIRE=1800
