lbobagent.icu {
	# 手动证书（腾讯云免费证书，M 部署轮）：境外 ACME http-01/tls-alpn 验证
	# 被跨境链路拦截（43.174.225.201 注入/重置），改用 DNS 验证签发的静态证书。
	# 有效期 90 天，到期前需重新申请并替换 /certs 下两个文件后重启 caddy。
	tls /certs/lbobagent.icu_bundle.crt /certs/lbobagent.icu.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 180s
			}
		}
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle /metrics {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
